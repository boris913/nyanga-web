# URL de l'API Nyanga, utilisée côté serveur et par src/proxy.ts pour relayer /api/*
API_URL=http://localhost:4000

# Secret partagé avec l'API (paramètre SSM /nyanga/prod/PROXY_SECRET) : transmet l'adresse IP réelle des visiteurs
PROXY_SECRET=

# Identifiant client OAuth Google (le même que GOOGLE_CLIENT_ID de l'API). Vide : bouton Google masqué.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# "true" affiche « Mot de passe oublié ? » (nécessite MAIL_DRIVER côté API)
NEXT_PUBLIC_PASSWORD_RESET=
