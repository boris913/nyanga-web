# URL de l'API Nyanga, utilisée côté serveur et pour la réécriture /api/*
API_URL=http://localhost:4000

# Identifiant client OAuth Google (le même que GOOGLE_CLIENT_ID de l'API). Vide : bouton Google masqué.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# "true" affiche « Mot de passe oublié ? » (nécessite MAIL_DRIVER côté API)
NEXT_PUBLIC_PASSWORD_RESET=
